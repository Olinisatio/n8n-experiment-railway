# ---------------------------------------------------------------------------
# Canonical production domain. THIS IS THE ONE THAT MATTERS FOR SEO.
#
# It must be the exact non-www form of your domain, with https and no trailing
# slash, e.g. https://quietparts.co
#
# Canonical tags, the sitemap, robots.txt and the OG tags are all derived from
# this single value. If it disagrees with the domain Google actually sees
# (www vs non-www), Google treats the sitemap as pointing at a different site
# and ignores it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# PostHog project API key (PostHog → Settings → Project → Project API Key).
# Leave blank and analytics is a permanent no-op — posthog-js is never even
# downloaded. Safe to leave blank locally.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API host. US cloud: https://us.i.posthog.com  EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Resend. Server-side only — never prefixed NEXT_PUBLIC_, or it would ship to
# the browser. Leave blank and /api/subscribe still returns ok, it just logs
# instead of sending.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# The From: address for the confirmation email. Must be on a domain you have
# verified inside Resend, e.g. "Quiet Parts <hello@quietparts.co>"
RESEND_FROM=

# Optional. If set, each new subscriber is also added to this Resend Audience
# (Resend → Audiences → the id in the URL).
RESEND_AUDIENCE_ID=
