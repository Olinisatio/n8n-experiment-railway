# Canonical production domain. MUST match the domain Google indexes, including
# the www / non-www choice — the sitemap, canonical tags and OG URLs all derive
# from this value. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# PostHog project API key (Project Settings → Project API Key).
# Leave blank locally to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API host. US cloud: https://us.i.posthog.com
# EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
